# Perfil activo (dev usa H2 en memoria; prod usa PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Puerto HTTP (Render/Railway suelen inyectar PORT automáticamente)
PORT=8080

# Base de datos PostgreSQL (en Neon usar DB_SSL_MODE=require)
DB_HOST=tu-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_SSL_MODE=require

# Secreto para firmar tokens JWT (obligatorio en prod, mínimo 32 caracteres)
JWT_SECRET=reemplazar-por-secreto-seguro-de-al-menos-32-caracteres

# Orígenes permitidos por CORS (separados por coma, sin barra final)
CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app

# Proveedor meteorológico
CLIMA_BASE_URL=https://api.open-meteo.com
